---
<Layout>
  <header id="site-nav" class="fixed inset-x-0 top-0 z-50 mix-blend-difference text-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 lg:px-10" aria-label="Main navigation">
      <a href="/" class="flex items-center gap-3 font-bold tracking-tight" aria-label="Spinoza Cafe home">
        <img src={profilePic} alt="" class="h-9 w-9 rounded-full object-cover ring-1 ring-white/50" />
        <span>SPINOZA<span class="text-acid">.</span></span>
      </a>
      <div class="hidden items-center gap-8 text-xs font-semibold uppercase tracking-[.18em] md:flex">
        <a href="#story" class="transition-opacity hover:opacity-60">Story</a>
        <a href="#feed" class="transition-opacity hover:opacity-60">Journal</a>
        <a href="#visit" class="transition-opacity hover:opacity-60">Visit</a>
      </div>
      <a href={`tel:${place.phone.replaceAll(' ', '')}`} class="rounded-full border border-white/50 px-4 py-2 text-xs font-semibold transition hover:bg-white hover:text-ink">Call us</a>
    </nav>
  </header>

  <main>
    <Hero profilePic={profilePic} rating={place.rating} reviews={place.reviews} />

    <section id="story" class="bg-bone px-5 py-24 text-ink lg:px-10 lg:py-36">
      <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
        <div class="reveal">
          <p class="eyebrow mb-6 text-espresso/60">01 / The philosophy</p>
          <h2 class="max-w-xl text-4xl font-extrabold leading-[.98] tracking-[-.06em] sm:text-6xl">A place for <span class="font-script text-6xl font-medium text-espresso sm:text-8xl">better</span> pauses.</h2>
        </div>
        <div class="reveal max-w-xl lg:justify-self-end">
          <p class="text-xl leading-relaxed text-espresso/80">Every detail matters. From 100% organic coffee beans to a room that lets ideas breathe, Spinoza is made for slow mornings, focused afternoons, and evenings that turn into memories.</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <span class="rounded-full border border-espresso/20 px-4 py-2 text-xs font-semibold">Organic coffee</span>
            <span class="rounded-full border border-espresso/20 px-4 py-2 text-xs font-semibold">Study friendly</span>
            <span class="rounded-full border border-espresso/20 px-4 py-2 text-xs font-semibold">Erbil made</span>
          </div>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-ink px-5 py-24 lg:px-10 lg:py-36">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:items-center">
        <div class="reveal">
          <p class="eyebrow mb-6 text-acid/70">02 / The ritual</p>
          <h2 class="max-w-2xl text-5xl font-extrabold leading-[.95] tracking-[-.07em] sm:text-7xl">Good coffee.<br /><span class="text-acid">Clear thinking.</span></h2>
        </div>
        <div class="reveal rounded-[2rem] border border-white/10 bg-white/[.04] p-8 backdrop-blur-xl lg:p-12">
          <div class="mb-10 flex items-center justify-between">
            <span class="eyebrow text-white/50">Today at Spinoza</span>
            <span class="flex items-center gap-2 text-xs font-semibold text-acid"><i class="h-2 w-2 animate-pulse rounded-full bg-acid"></i><span id="status">Open now</span></span>
          </div>
          <div class="grid grid-cols-2 gap-8">
            <div><p class="eyebrow text-white/40">Rating</p><p class="mt-2 text-5xl font-bold">4.9<span class="text-lg text-acid"> / 5</span></p></div>
            <div><p class="eyebrow text-white/40">Community</p><p class="mt-2 text-5xl font-bold">1.5k<span class="text-lg text-acid">+</span></p></div>
          </div>
          <p class="mt-10 border-t border-white/10 pt-6 text-sm leading-relaxed text-white/60">Come for the espresso. Stay for the quiet corner, the next move, or the conversation you did not know you needed.</p>
        </div>
      </div>
    </section>

    <Gallery posts={gallery} />

    <section id="visit" class="bg-bone px-5 py-24 text-ink lg:px-10 lg:py-36">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div class="reveal">
            <p class="eyebrow mb-6 text-espresso/60">03 / Find us</p>
            <h2 class="text-5xl font-extrabold tracking-[-.07em] sm:text-7xl">Your table<br /><span class="font-script text-7xl font-medium sm:text-9xl">awaits.</span></h2>
          </div>
          <a href="https://www.google.com/maps/search/?api=1&query=Spinoza+Cafe+Rami+Towers+Erbil" target="_blank" rel="noreferrer" class="inline-flex w-fit items-center gap-3 rounded-full bg-ink px-6 py-4 text-sm font-bold text-bone transition hover:bg-espresso">Open in Maps <span aria-hidden="true">↗</span></a>
        </div>
        <div class="grid overflow-hidden rounded-[2rem] bg-espresso text-bone lg:grid-cols-[1.1fr_.9fr]">
          <div class="min-h-[320px] bg-[radial-gradient(circle_at_30%_30%,rgba(212,245,154,.22),transparent_25%),linear-gradient(135deg,#33251d,#111)] p-8 lg:p-12">
            <div class="flex h-full flex-col justify-between">
              <div class="flex items-center gap-3"><span class="h-3 w-3 rounded-full bg-acid"></span><span class="eyebrow text-acid">Spinoza, Erbil</span></div>
              <p class="max-w-sm text-3xl font-semibold leading-tight">Rami Towers,<br />English Village Road</p>
            </div>
          </div>
          <div class="space-y-8 p-8 lg:p-12">
            <div><p class="eyebrow mb-2 text-bone/50">Address</p><p class="leading-relaxed text-bone/80">{place.address}</p></div>
            <div><p class="eyebrow mb-2 text-bone/50">Call</p><a class="text-xl font-semibold hover:text-acid" href={`tel:${place.phone.replaceAll(' ', '')}`}>{place.phone}</a></div>
            <div><p class="eyebrow mb-2 text-bone/50">Hours</p><p class="text-bone/80">Open now · hours vary by day</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-acid px-5 py-20 text-ink lg:px-10">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-10 md:flex-row md:items-center">
        <div><p class="eyebrow mb-5 text-ink/60">Follow the details</p><h2 class="text-4xl font-extrabold tracking-[-.06em] sm:text-6xl">@spinozaerbil</h2></div>
        <a href="https://www.instagram.com/spinozaerbil/" target="_blank" rel="noreferrer" class="rounded-full border-2 border-ink px-7 py-4 text-sm font-bold transition hover:bg-ink hover:text-acid">Follow on Instagram ↗</a>
      </div>
    </section>
  </main>

  <footer class="bg-ink px-5 py-10 text-bone lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-6 text-sm md:flex-row">
      <p class="font-bold">SPINOZA<span class="text-acid">.</span></p>
      <p class="text-white/40">Every detail matters. © {new Date().getFullYear()} Spinoza Cafe.</p>
    </div>
  </footer>
</Layout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible'));
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

  const status = document.querySelector('#status');
  if (status) {
    const hour = new Date().getHours();
    status.textContent = hour >= 8 && hour < 23 ? 'Open now' : 'Check today’s hours';
  }

  document.querySelectorAll('.tilt').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      if (reduced) return;
      const rect = card.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      card.style.transform = `perspective(900px) rotateX(${y * -5}deg) rotateY(${x * 5}deg) scale3d(1.02,1.02,1.02)`;
    });
    card.addEventListener('pointerleave', () => { card.style.transform = ''; });
  });
</script>