---
interface Props {
  posts: { image: string; caption: string; likes: number }[];
}
const { posts } = Astro.props;
---
<section id="feed" class="bg-[#e4e2d9] px-5 py-24 text-ink lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="reveal"><p class="eyebrow mb-6 text-espresso/60">Instagram / @spinozaerbil</p><h2 class="max-w-2xl text-5xl font-extrabold leading-[.9] tracking-[-.07em] sm:text-7xl">Life, served<br /><span class="font-script text-7xl font-medium text-espresso sm:text-9xl">beautifully.</span></h2></div>
      <p class="max-w-xs text-sm leading-relaxed text-espresso/60">Coffee, community, chess, and the details that make a place feel like yours.</p>
    </div>
    <div class="grid auto-rows-[250px] grid-cols-2 gap-3 md:auto-rows-[280px] md:grid-cols-4">
      {posts.map((post, index) => (
        <article class:list={[
          'tilt group relative overflow-hidden rounded-2xl bg-espresso',
          index === 0 && 'col-span-2 row-span-2',
          index === 3 && 'md:col-start-3'
        ]}>
          <img src={post.image} alt={post.caption.slice(0, 80)} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
          <div class="absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-5 pt-16 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
            <p class="line-clamp-3 text-sm leading-relaxed text-white">{post.caption}</p>
            <div class="mt-4 flex gap-4 text-xs text-white/60"><span>♡ {post.likes}</span><span>◌ @spinozaerbil</span></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>